# /etc/nginx/vhost.d/{{ item.name }}.conf
# Generated by Ansible for {{ ansible_facts['fqdn'] }}.
#
{% for section, directives in item if section != 'name' %}
{{ section }} {
{% for directive, value in directives %}
    {{ directive }}: {{ value }};
{% endfor %}
}
{% else %}
# Ansible: item '{{ item.name }}' has no sections in nginx_vhosts
{% endfor %}
