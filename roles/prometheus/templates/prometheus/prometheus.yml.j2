---
# /etc/prometheus/prometheus.yml
# Generated by Ansible for {{ ansible_facts['fqdn'] }}.
# See https://prometheus.io/docs/prometheus/ for documentation.
#
global:
  scrape_interval: '{{ prometheus_global_scrape_interval }}'
  evaluation_interval: '{{ prometheus_global_evaluation_interval }}'
  scrape_timeout: '{{ prometheus_global_scrape_timeout }}'

  # Attach these labels to any time series or alerts when communicating with
  # external systems (federation, remote storage, Alertmanager).
  external_labels:
{% if prometheus_external_labels is defined %}
{% for label_key, label_value in prometheus_external_labels.items() %}
    {{ label_key }}: '{{ label_value }}'
{% endfor %}
{% else %}
    monitor: '{{ ansible_facts['fqdn'] }}'
{% endif %}

# Alertmanager configuration
alerting:
  alertmanagers:
  - static_configs:
    - targets: ['localhost:{{ prometheus_alertmanager_port }}']
      labels:
        instance: '{{ ansible_facts['fqdn'] }}:{{ prometheus_alertmanager_port }}'

# Load rules once and periodically evaluate them according to the global 'evaluation_interval'.
rule_files:
  # - "first_rules.yml"
  # - "second_rules.yml"

# Scrape configuration
scrape_configs:
  - job_name: 'prometheus'
    scrape_interval: 5s
    scrape_timeout: 5s
    static_configs:
    - targets: ['localhost:{{ prometheus_port }}']
      labels:
        instance: '{{ ansible_facts['fqdn'] }}:{{ prometheus_port }}'
{% for scrape_config in prometheus_scrape_configs %}

  - job_name: '{{ scrape_config.job_name }}'
{% if scrape_config.scrape_interval is defined %}
    scrape_interval: '{{ scrape_config.scrape_interval }}'
{% endif %}
{% if scrape_config.honor_labels is defined %}
    honor_labels: {{ scrape_config.honor_labels }}
{% endif %}
{% if scrape_config.scheme is defined %}
    metrics_path: '{{ scrape_config.scheme }}'
{% endif %}
{% if scrape_config.metrics_path is defined %}
    metrics_path: '{{ scrape_config.metrics_path }}'
{% endif %}
{% if scrape_config.params is defined %}
    params:
{% for param_key, param_values in scrape_config.params.items() %}
      '{{ param_key }}':
{% for param_item in param_values %}
        - '{{ param_item }}'
{% endfor %}
{% endfor %}
{% endif %}
{% if scrape_config.static_configs is defined %}
    static_configs:
{% for static_config in scrape_config.static_configs %}
    - targets: ['{{ static_config.targets | join("','") }}']
{% if static_config.labels is defined %}
      labels:
{% for label_key, label_value in static_config.labels.items() %}
        {{ label_key }}: '{{ label_value }}'
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
